# Copy to Vera/.env and fill in. Never commit Vera/.env.

NODE_ENV=production
PORT=4100

# Public origin of Vera. The MCP endpoint is ${VERA_PUBLIC_URL}/mcp.
VERA_PUBLIC_URL=https://ai.vizibble.in

# Vera's own database (a separate database; never the main Vizibble database)
VERA_DATABASE_URL=postgres://vera:password@db.example.com:5432/vera
# Hosted Redis for the WhatsApp queue and per-user rate limits
REDIS_URL=rediss://default:password@redis.example.com:6379
# 32 random bytes, base64: openssl rand -base64 32. Encrypts stored grant tokens and paused runs.
VERA_ENCRYPTION_KEY=

# Main Vizibble application
VIZIBBLE_API_URL=https://app.vizibble.in
# Same value as VERA_SERVICE_TOKEN on the main server: openssl rand -base64 48
VIZIBBLE_SERVICE_TOKEN=
# Better Auth issuer: main URL + /api/v2/auth
VIZIBBLE_OAUTH_ISSUER=https://app.vizibble.in/api/v2/auth

# OpenAI (WhatsApp assistant; ChatGPT and Claude bring their own model)
OPENAI_API_KEY=
AI_MODEL=gpt-5.5

# Meta WhatsApp Cloud API
WHATSAPP_ENABLED=false
# Any random string; enter the same value in the Meta app's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app → App settings → Basic → App secret (verifies X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# System-user permanent token with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v23.0

WORKER_CONCURRENCY=4
