{
  "name": "@vizibble/vera",
  "version": "0.1.0",
  "description": "Vera: the Vizibble AI integration platform (MCP, WhatsApp and future AI channels)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "worker:dev": "bun --watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "format": "bunx prettier . --write"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openai/agents": "^0.21.0",
    "axios": "^1.20.0",
    "bullmq": "^6.7.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "openai": "^7.55.0",
    "opossum": "^10.0.0",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/express": "^5.0.6",
    "@types/opossum": "^8.1.9",
    "drizzle-kit": "^0.31.11",
    "prettier": "catalog:",
    "typescript": "^6.0.2"
  }
}
