# Copy to infra/.env and fill in. Never commit infra/.env.

# Public address. Use a real domain in production; Caddy fetches HTTPS certificates automatically
# (the domain's DNS must point at this server, with ports 80 and 443 open).
DOMAIN=localhost
PUBLIC_URL=https://localhost

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Database
POSTGRES_USER=vizibble
POSTGRES_PASSWORD=
POSTGRES_DB=vizibble

# Transactional email via SMTP (Resend, Postmark, SES, Brevo, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vizibble <no-reply@example.com>"

# AI integrations (Vera). Leave disabled until Vera is deployed; nothing else depends on it.
AI_INTEGRATIONS_ENABLED=false
# Vera's public MCP endpoint, e.g. https://ai.vizibble.in/mcp
VERA_MCP_URL=
# Shared secret Vera presents on every call (Vera's VIZIBBLE_SERVICE_TOKEN): openssl rand -base64 48
VERA_SERVICE_TOKEN=
# Number users message to link WhatsApp, e.g. +91 98765 43210 (optional)
VERA_WHATSAPP_NUMBER=
